# Canonical site URL (no trailing slash). Used for canonical tags, sitemap and Open Graph.
SITE_URL=https://kennet-kitchens.vercel.app

# Demo mode: noindex + demo notice. Set to "false" for a real client launch.
PUBLIC_IS_DEMO=true

# Optional: form endpoint (e.g. https://formspree.io/f/xxxxxxx or /api/quote).
# Leave empty to use the built-in stub that just shows the success state.
PUBLIC_FORM_ENDPOINT=
