---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import CtaBand from '@/components/CtaBand.astro';
import CtaButtons from '@/components/CtaButtons.astro';
import Img from '@/components/ui/Img.astro';
import Icon from '@/components/ui/Icon.astro';
import { article } from '@/lib/schema';
import { imageUrl } from '@/lib/images';
import { BUSINESS } from '@/config';

export async function getStaticPaths() {
  const posts = await getCollection('advice');
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'advice'>;
}
const { entry } = Astro.props;
const d = entry.data;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);
const services = (await getCollection('services')).filter((s) => d.related.includes(s.id));
const others = (await getCollection('advice')).filter((p) => p.id !== entry.id);
const fmt = (date: Date) => date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const real = await imageUrl(d.image);
const image = real ? new URL(real, Astro.site).href : new URL('/og/advice.png', Astro.site).href;
---

<BaseLayout
  title={d.seoTitle}
  description={d.description}
  og="advice"
  ogImageUrl={real ? image : undefined}
  type="article"
  published={d.published}
  heroImage={d.image}
  heroSizes="(min-width: 1100px) 1040px, 100vw"
  schema={[article(Astro.site, { title: d.title, description: d.description, path: `/advice/${entry.id}`, published: d.published, updated: d.updated, image })]}
>
  <article>
    <header class="container-x pt-10 sm:pt-14">
      <Breadcrumbs items={[{ name: 'Advice', href: '/advice' }, { name: d.title, href: `/advice/${entry.id}` }]} />
      <div class="mx-auto mt-10 max-w-3xl text-center">
        <p class="eyebrow">Advice</p>
        <h1 class="mt-4 text-[clamp(2rem,1.4rem+2.6vw,3.5rem)]">{d.title}</h1>
        <p class="mt-5 text-sm text-ink-muted">
          By the {BUSINESS.name} team · Published <time datetime={d.published.toISOString()}>{fmt(d.published)}</time>
          {d.updated && <> · Updated <time datetime={d.updated.toISOString()}>{fmt(d.updated)}</time></>} · {d.readingTime}
        </p>
      </div>
      <Img image={d.image} priority ratio="16/9" class="mx-auto mt-10 max-w-5xl rounded-2xl" sizes="(min-width: 1100px) 1040px, 100vw" />
    </header>

    <div class="container-x section-tight grid gap-12 lg:grid-cols-12">
      <aside class="lg:col-span-3" aria-labelledby="toc-title">
        <nav class="lg:sticky lg:top-[calc(var(--header-h)+1.5rem)]" aria-labelledby="toc-title">
          <h2 id="toc-title" class="font-sans text-sm font-bold tracking-[0.12em] text-brass-text uppercase">In this guide</h2>
          <ol class="mt-3 space-y-1 border-l border-line text-sm">
            {toc.map((h) => <li><a href={`#${h.slug}`} class="-ml-px block border-l-2 border-transparent py-1.5 pl-4 text-ink-soft no-underline hover:border-teal hover:text-ink">{h.text}</a></li>)}
          </ol>
        </nav>
      </aside>
      <div class="min-w-0 lg:col-span-9">
        <div class="prose mx-auto lg:mx-0"><Content /></div>
        <div class="mt-12 max-w-2xl rounded-2xl bg-teal-tint p-6 sm:p-8">
          <h2 class="text-2xl">Want advice on your own project?</h2>
          <p class="mt-2 text-ink-soft">Book a free design visit. We’ll measure up, talk it through and send a fixed, itemised quote.</p>
          <CtaButtons class="mt-6" />
        </div>
      </div>
    </div>
  </article>

  <section class="section bg-surface" aria-labelledby="related-title">
    <div class="container-x">
      <SectionHeading eyebrow="Related services" title="How we can help" id="related-title" />
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {services.map((s, i) => <ServiceCard href={`/${s.id}`} title={s.data.name} text={s.data.summary} image={s.data.image} delay={i * 70} />)}
      </div>
      <h2 class="mt-16 text-2xl">More advice</h2>
      <ul class="mt-4 divide-y divide-line border-y border-line">
        {others.map((p) => <li><a href={`/advice/${p.id}`} class="group flex min-h-14 items-center justify-between gap-4 py-3 font-semibold no-underline hover:text-teal">{p.data.title}<Icon name="arrow" size={18} class="flex-none text-teal transition-transform group-hover:translate-x-1" /></a></li>)}
      </ul>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
