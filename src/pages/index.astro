---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CtaButtons from '@/components/CtaButtons.astro';
import StatsStrip from '@/components/StatsStrip.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import BeforeAfter from '@/components/BeforeAfter.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import ProcessSteps from '@/components/ProcessSteps.astro';
import ReviewsSection from '@/components/ReviewsSection.astro';
import FaqList from '@/components/FaqList.astro';
import CtaBand from '@/components/CtaBand.astro';
import AreaMap from '@/components/AreaMap.astro';
import Img from '@/components/ui/Img.astro';
import Icon from '@/components/ui/Icon.astro';
import { DIFFERENTIATORS, HOME_FAQS } from '@/data/content';
import { AREAS, BUSINESS } from '@/config';
import { localBusiness, website } from '@/lib/schema';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const kitchens = services.filter((s) => s.data.category === 'kitchens');
const bathrooms = services.filter((s) => s.data.category === 'bathrooms');
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects[0];
const others = projects.slice(1, 3);
---

<BaseLayout
  title="Kitchen & Bathroom Fitters in Swindon | Kennet"
  description="Swindon kitchen and bathroom fitters since 2012. In-house design with 3D visuals, our own fitters, fixed written quotes and a 10-year guarantee."
  heroImage="heroKitchen"
  heroSizes="(min-width: 1200px) 640px, (min-width: 1024px) 52vw, 100vw"
  schema={[localBusiness(Astro.site), website(Astro.site)]}
>
  <!-- Hero: no entrance animation, so nothing delays LCP -->
  <section class="relative overflow-hidden">
    <div class="container-x grid items-center gap-10 pt-8 pb-14 sm:pt-12 lg:grid-cols-12 lg:gap-12 lg:pt-16 lg:pb-20">
      <div class="lg:col-span-6">
        <p class="eyebrow">Swindon &amp; Wiltshire · Since {BUSINESS.foundingYear}</p>
        <h1 class="mt-4 text-[clamp(2.5rem,1.6rem+3.6vw,4.5rem)] leading-[1.04]">
          Kitchen and Bathroom Fitters in Swindon
        </h1>
        <p class="lead mt-6">
          {BUSINESS.tagline}. Designed in 3D, fixed in writing and guaranteed for ten years.
        </p>
        <CtaButtons class="mt-8" />
        <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm font-semibold text-ink-soft">
          <li class="flex items-center gap-2"><Icon name="check" size={18} class="text-teal" strokeWidth={2.25} /> Free home design visit</li>
          <li class="flex items-center gap-2"><Icon name="check" size={18} class="text-teal" strokeWidth={2.25} /> No subcontractors</li>
          <li class="flex items-center gap-2"><Icon name="check" size={18} class="text-teal" strokeWidth={2.25} /> Fixed written quotes</li>
        </ul>
      </div>
      <div class="relative lg:col-span-6">
        <Img image="heroKitchen" priority ratio="4/3" sizes="(min-width: 1200px) 640px, (min-width: 1024px) 52vw, 100vw" class="rounded-[1.5rem]" />
        <div class="absolute -bottom-6 left-4 hidden items-center gap-3 rounded-2xl bg-white p-4 pr-6 shadow-[var(--shadow-lift)] sm:flex">
          <span class="grid h-12 w-12 place-items-center rounded-full bg-teal text-white"><Icon name="shield" size={24} /></span>
          <p class="text-sm leading-tight">
            <span class="block font-serif text-xl">{BUSINESS.guaranteeYears}-year guarantee</span>
            <span class="text-ink-soft">on all our workmanship</span>
          </p>
        </div>
      </div>
    </div>
  </section>

  <StatsStrip />

  <!-- Services -->
  <section class="section" aria-labelledby="services-title">
    <div class="container-x">
      <SectionHeading
        eyebrow="What we do"
        title="Kitchens and bathrooms, start to finish"
        id="services-title"
        lead="We design, supply and fit both, using our own team for every trade. That means one plan, one price and one person to call, whether it’s a family kitchen or a downstairs toilet."
      />
      <div class="mt-12 grid gap-6 md:grid-cols-2">
        <ServiceCard
          large
          headingLevel="h3"
          href="/kitchens"
          title="Kitchens"
          image="shakerSage"
          text="From layout and 3D design to the last plinth. Shaker, handleless and in-frame styles, with quartz, granite, laminate or solid wood worktops. Typical projects £12,000 to £35,000."
        />
        <ServiceCard
          large
          headingLevel="h3"
          href="/bathrooms"
          title="Bathrooms"
          image="panelledBathroom"
          delay={100}
          text="Family bathrooms, en-suites, wet rooms and cloakrooms, with waterproofing done properly and tiling by our own tiler. Typical projects £8,000 to £20,000."

        />
      </div>
      <div class="mt-12 grid gap-8 md:grid-cols-2">
        <div data-reveal>
          <h3 class="font-sans text-sm font-bold tracking-[0.12em] text-brass-text uppercase">Kitchen services</h3>
          <ul class="mt-3 divide-y divide-line border-y border-line">
            {kitchens.map((s) => (
              <li><a href={`/${s.id}`} class="svc-link">{s.data.name}<Icon name="arrow" size={18} /></a></li>
            ))}
          </ul>
        </div>
        <div data-reveal style="--reveal-delay:100ms">
          <h3 class="font-sans text-sm font-bold tracking-[0.12em] text-brass-text uppercase">Bathroom services</h3>
          <ul class="mt-3 divide-y divide-line border-y border-line">
            {bathrooms.map((s) => (
              <li><a href={`/${s.id}`} class="svc-link">{s.data.name}<Icon name="arrow" size={18} /></a></li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured projects -->
  <section class="section bg-surface" aria-labelledby="projects-title">
    <div class="container-x">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <SectionHeading
          eyebrow="Recent projects"
          title="See the difference"
          id="projects-title"
          lead="Every project starts with a home visit and ends with a walk-round. Slide to compare one of our recent kitchens, before and after."
        />
        <a href="/projects" class="link-arrow">View all projects <Icon name="arrow" size={18} /></a>
      </div>
      <div class="mt-12 grid items-start gap-10 lg:grid-cols-12">
        <div class="lg:col-span-7" data-reveal>
          <BeforeAfter before={featured.data.before} after={featured.data.after} label={featured.data.title} sizes="(min-width: 1024px) 680px, 100vw" />
        </div>
        <div class="lg:col-span-5" data-reveal style="--reveal-delay:120ms">
          <p class="text-xs font-bold tracking-[0.12em] text-brass-text uppercase">Kitchen · {featured.data.location}</p>
          <h3 class="mt-2 text-3xl">{featured.data.title}</h3>
          <p class="mt-4 text-ink-soft">{featured.data.summary} We removed a load-bearing wall, levelled two floors into one and kept the whole project on its fixed price.</p>
          <dl class="mt-6 grid grid-cols-2 gap-4 border-t border-line pt-6 text-sm">
            <div><dt class="text-ink-muted">Duration</dt><dd class="font-bold">{featured.data.duration}</dd></div>
            <div><dt class="text-ink-muted">Budget</dt><dd class="font-bold">{featured.data.budget}</dd></div>
          </dl>
          <a href={`/projects/${featured.id}`} class="btn btn-secondary mt-8">Read the case study</a>
        </div>
      </div>
      <div class="mt-14 grid gap-6 md:grid-cols-2">
        {others.map((p, i) => <ProjectCard project={p} delay={i * 100} />)}
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section" aria-labelledby="process-title">
    <div class="container-x">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <SectionHeading
          eyebrow="How it works"
          title="Five steps, one team"
          id="process-title"
          lead="No showroom pressure and no chasing trades. You deal with the same small team from the first visit to the final clean."
        />
        <a href="/our-process" class="link-arrow">More about our process <Icon name="arrow" size={18} /></a>
      </div>
      <div class="mt-12"><ProcessSteps /></div>
    </div>
  </section>

  <!-- Why choose us -->
  <section class="section on-dark bg-ink text-[#d9dee3]" aria-labelledby="why-title">
    <div class="container-x grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4">
        <div data-reveal>
          <p class="eyebrow">Why Kennet</p>
          <h2 id="why-title" class="mt-3 text-white">The reasons people pick us, and come back</h2>
          <p class="mt-5 text-lg text-[#a9b4be]">
            We’re a team of {BUSINESS.teamSize}: a designer, fitters, a tiler, a plumber and an electrician, all employed directly. That’s small enough to care about every job and big enough to finish it on time.
          </p>
          <a href="/about" class="btn btn-secondary mt-8">Meet the team</a>
        </div>
      </div>
      <ul class="grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:col-span-8">
        {DIFFERENTIATORS.map((d, i) => (
          <li class="flex gap-4" data-reveal style={`--reveal-delay:${(i % 2) * 90}ms`}>
            <span class="grid h-12 w-12 flex-none place-items-center rounded-full border border-white/15 text-brass-light"><Icon name={d.icon} size={22} /></span>
            <div>
              <h3 class="text-xl text-white">{d.title}</h3>
              <p class="mt-2 text-[#a9b4be]">{d.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <ReviewsSection />

  <!-- Areas -->
  <section class="section" aria-labelledby="areas-title">
    <div class="container-x grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <SectionHeading
          eyebrow="Areas we cover"
          title="Local to Swindon and the towns around it"
          id="areas-title"
          lead="Our workshop is in Swindon and every project is within about 25 miles, so your project manager is never far away, during the job or years later."
        />
        <ul class="mt-8 grid gap-2 sm:grid-cols-2" data-reveal>
          {AREAS.map((a) => (
            <li>
              <a href={`/${a.slug}`} class="group flex min-h-12 items-center justify-between gap-3 rounded-lg border border-line bg-white px-4 py-2 font-semibold no-underline hover:border-teal">
                <span><span class="sr-only">Kitchen and bathroom fitters in </span>{a.name}</span>
                <Icon name="arrow" size={16} class="text-teal transition-transform group-hover:translate-x-1" />
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div data-reveal style="--reveal-delay:120ms"><AreaMap /></div>
    </div>
  </section>

  <!-- FAQ teaser -->
  <section class="section bg-surface" aria-labelledby="faq-title">
    <div class="container-x grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <SectionHeading eyebrow="FAQs" title="Questions we hear most" id="faq-title" />
        <p class="mt-4 text-ink-soft">Can’t see your question? Call us on <a href={BUSINESS.phone.href} class="link">{BUSINESS.phone.display}</a> and talk to a real person, not a call centre.</p>
        <a href="/faqs" class="link-arrow mt-6">Read all FAQs <Icon name="arrow" size={18} /></a>
      </div>
      <div class="lg:col-span-8"><FaqList faqs={HOME_FAQS} /></div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .svc-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.5rem;
    font-weight: 700;
    text-decoration: none;
  }
  .svc-link :global(svg) {
    color: var(--color-teal);
    transition: transform 200ms var(--ease-out-soft);
  }
  .svc-link:hover {
    color: var(--color-teal);
  }
  .svc-link:hover :global(svg) {
    transform: translateX(4px);
  }
</style>
