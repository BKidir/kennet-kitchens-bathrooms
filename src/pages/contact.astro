---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import ContactForm from '@/components/forms/ContactForm.astro';
import AreaMap from '@/components/AreaMap.astro';
import Icon from '@/components/ui/Icon.astro';
import { BUSINESS } from '@/config';
import { localBusiness } from '@/lib/schema';
const a = BUSINESS.address;
---

<BaseLayout
  title="Contact Kennet Kitchens & Bathrooms | Swindon"
  description="Call 01632 960 482, email or send us a message. Kennet Kitchens & Bathrooms, Unit 4, Kennet Court, Swindon SN1 0AA. Open Monday to Saturday."
  schema={[localBusiness(Astro.site)]}
>
  <PageHero
    crumbs={[{ name: 'Contact', href: '/contact' }]}
    eyebrow="Contact"
    title="Contact Our Swindon Team"
    lead="Questions, a quick price check or ready to book a design visit? Call, email or send a message. We reply to everyone within one working day."
    ctas={false}
  />

  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <h2 class="text-3xl">Send us a message</h2>
        <p class="mt-3 text-ink-soft">For a detailed quote, our <a href="/get-a-quote" class="link">quote form</a> is quicker. For anything else, use the form below.</p>
        <div class="mt-8"><ContactForm /></div>
      </div>
      <aside class="space-y-8 lg:col-span-5" aria-labelledby="details-title">
        <div class="rounded-2xl border border-line bg-white p-6 sm:p-8">
          <h2 id="details-title" class="text-2xl">Our details</h2>
          <address class="mt-5 space-y-4 not-italic">
            <p class="flex gap-3"><Icon name="pin" size={20} class="mt-0.5 flex-none text-teal" /><span><strong>{BUSINESS.name}</strong><br />{a.street}<br />{a.locality}, {a.region}<br />{a.postcode}</span></p>
            <p class="flex gap-3"><Icon name="phone" size={20} class="mt-0.5 flex-none text-teal" /><a href={BUSINESS.phone.href} class="link">{BUSINESS.phone.display}</a></p>
            <p class="flex gap-3"><Icon name="mail" size={20} class="mt-0.5 flex-none text-teal" /><a href={`mailto:${BUSINESS.email}`} class="link break-all">{BUSINESS.email}</a></p>
          </address>
          <h3 class="mt-6 border-t border-line pt-6 font-sans text-sm font-bold tracking-[0.12em] text-brass-text uppercase">Opening hours</h3>
          <dl class="mt-3 space-y-1 text-sm">
            {BUSINESS.hours.map((h) => <div class="flex justify-between gap-4"><dt>{h.days}</dt><dd class="font-bold">{h.opens.replace(/^0/, '')} – {h.closes}</dd></div>)}
            <div class="flex justify-between gap-4"><dt>Sunday</dt><dd class="font-bold">Closed</dd></div>
          </dl>
          <p class="mt-3 text-sm text-ink-muted">{BUSINESS.closedNote}. Design visits by appointment only; we don’t have a walk-in showroom.</p>
        </div>
        <AreaMap />
      </aside>
    </div>
  </section>
</BaseLayout>
