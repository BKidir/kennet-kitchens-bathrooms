---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import QuoteForm from '@/components/forms/QuoteForm.astro';
import Icon from '@/components/ui/Icon.astro';
import { BUSINESS } from '@/config';
import { REVIEWS } from '@/data/content';
const review = REVIEWS[5];
---

<BaseLayout
  title="Get a Free Kitchen or Bathroom Quote | Kennet"
  description="Request a free, no-obligation quote for a new kitchen or bathroom in Swindon and Wiltshire. Six quick steps, and we’ll call you within one working day."
>
  <section class="container-x pt-10 pb-16 sm:pt-14 lg:pb-24">
    <Breadcrumbs items={[{ name: 'Get a quote', href: '/get-a-quote' }]} />
    <div class="mt-8 grid gap-12 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-8">
        <p class="eyebrow">Free quote</p>
        <h1 class="mt-3 text-[clamp(2rem,1.5rem+2.2vw,3.25rem)]">Get a Free Kitchen or Bathroom Quote</h1>
        <p class="lead mt-4">Tell us a little about your project. It takes about two minutes, and there’s no obligation.</p>
        <div class="mt-10"><QuoteForm /></div>
      </div>
      <aside class="space-y-6 lg:col-span-4" aria-label="About your quote">
        <div class="rounded-2xl border border-line bg-white p-6">
          <h2 class="text-xl">What happens next</h2>
          <ol class="mt-4 space-y-4 text-sm">
            <li class="flex gap-3"><span class="grid h-7 w-7 flex-none place-items-center rounded-full bg-ink text-xs font-bold text-white">1</span><span>We call within one working day, at the time you choose.</span></li>
            <li class="flex gap-3"><span class="grid h-7 w-7 flex-none place-items-center rounded-full bg-ink text-xs font-bold text-white">2</span><span>A designer visits to measure up and bring samples.</span></li>
            <li class="flex gap-3"><span class="grid h-7 w-7 flex-none place-items-center rounded-full bg-ink text-xs font-bold text-white">3</span><span>You get a 3D design and a fixed, itemised quote.</span></li>
          </ol>
        </div>
        <div class="rounded-2xl bg-teal-tint p-6">
          <h2 class="text-xl">Prefer to talk?</h2>
          <p class="mt-2 text-sm text-ink-soft">Call us {BUSINESS.hours.map((h) => `${h.short} ${h.opens.replace(/^0/, '')}–${h.closes}`).join(', ')}.</p>
          <a href={BUSINESS.phone.href} class="btn btn-primary mt-4 w-full"><Icon name="phone" size={18} /> {BUSINESS.phone.display}</a>
        </div>
        <figure class="rounded-2xl border border-line bg-white p-6">
          <Icon name="quote" size={24} class="text-brass" />
          <blockquote class="mt-3 font-serif text-lg">“{review.quote}”</blockquote>
          <figcaption class="mt-3 text-sm text-ink-muted">{review.name}, {review.place}. <span class="block text-[0.75rem]">Sample review</span></figcaption>
        </figure>
        <ul class="space-y-2 text-sm text-ink-soft">
          <li class="flex gap-2"><Icon name="check" size={18} class="flex-none text-teal" /> Your details are only used to arrange your quote</li>
          <li class="flex gap-2"><Icon name="check" size={18} class="flex-none text-teal" /> No pressure, no obligation</li>
          <li class="flex gap-2"><Icon name="check" size={18} class="flex-none text-teal" /> {BUSINESS.guaranteeYears}-year guarantee on all our work</li>
        </ul>
      </aside>
    </div>
  </section>
</BaseLayout>
