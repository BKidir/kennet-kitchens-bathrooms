---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import FaqList from '@/components/FaqList.astro';
import JsonLd from '@/components/JsonLd.astro';
import CtaBand from '@/components/CtaBand.astro';
import { FAQ_GROUPS } from '@/data/content';
import { faqPage } from '@/lib/schema';
import { BUSINESS } from '@/config';
---

<BaseLayout
  title="Kitchen & Bathroom FAQs | Kennet, Swindon"
  description="Answers to common questions about our kitchen and bathroom fitting: quotes, costs, timings, disruption, guarantees and how we work in Swindon."
>
  <PageHero
    crumbs={[{ name: 'FAQs', href: '/faqs' }]}
    eyebrow="FAQs"
    title="Kitchen and Bathroom Fitting: Your Questions Answered"
    lead="Straight answers to the questions we’re asked most. If yours isn’t here, call us or send a message and a real person will reply."
  />

  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <nav class="lg:col-span-3" aria-labelledby="faq-nav">
        <div class="lg:sticky lg:top-[calc(var(--header-h)+1.5rem)]">
          <h2 id="faq-nav" class="font-sans text-sm font-bold tracking-[0.12em] text-brass-text uppercase">Topics</h2>
          <ul class="mt-3 space-y-1 border-l border-line text-sm">
            {FAQ_GROUPS.map((g) => <li><a href={`#${g.id}`} class="-ml-px block border-l-2 border-transparent py-2 pl-4 text-ink-soft no-underline hover:border-teal hover:text-ink">{g.title}</a></li>)}
          </ul>
          <p class="mt-8 text-sm text-ink-soft">Still have a question? Call <a href={BUSINESS.phone.href} class="link">{BUSINESS.phone.display}</a> or <a href="/contact" class="link">send us a message</a>.</p>
        </div>
      </nav>
      <div class="space-y-14 lg:col-span-9">
        {FAQ_GROUPS.map((g) => (
          <section aria-labelledby={g.id}>
            <h2 id={g.id} class="text-3xl">{g.title}</h2>
            <FaqList faqs={g.faqs} schema={false} class="mt-6" />
          </section>
        ))}
      </div>
    </div>
  </section>
  <JsonLd data={faqPage(FAQ_GROUPS.flatMap((g) => g.faqs))} />

  <CtaBand />
</BaseLayout>
