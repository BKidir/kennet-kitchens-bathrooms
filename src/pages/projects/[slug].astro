---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import BeforeAfter from '@/components/BeforeAfter.astro';
import Gallery from '@/components/Gallery.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/ui/Icon.astro';
import type { GalleryItem } from '@/data/gallery';
import { images } from '@/data/images';
import { imageUrl } from '@/lib/images';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'projects'>;
}
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const services = (await getCollection('services')).filter((s) => d.services.includes(s.id));
const others = (await getCollection('projects')).filter((p) => p.id !== entry.id).sort((a, b) => a.data.order - b.data.order);
const label = { kitchens: 'Kitchen', bathrooms: 'Bathroom', 'wet-rooms': 'Wet room' }[d.category];
const gallery: GalleryItem[] = d.gallery.map((image) => ({
  image,
  category: d.category,
  title: images[image].alt.replace(/^(Before|After):\s*/, ''),
  location: d.location,
}));
const og = await imageUrl(d.after);
const facts = [
  { label: 'Location', value: d.location, icon: 'pin' as const },
  { label: 'Property', value: d.property, icon: 'home' as const },
  { label: 'Duration', value: d.duration, icon: 'calendar' as const },
  { label: 'Budget band', value: d.budget, icon: 'pound' as const },
];
---

<BaseLayout title={d.seoTitle} description={d.description} og="projects" ogImageUrl={og ? new URL(og, Astro.site).href : undefined}>
  <section class="border-b border-line">
    <div class="container-x py-10 sm:py-14 lg:py-16">
      <Breadcrumbs items={[{ name: 'Projects', href: '/projects' }, { name: d.title, href: `/projects/${entry.id}` }]} />
      <div class="mt-8 grid gap-10 lg:grid-cols-12 lg:gap-14">
        <div class="lg:col-span-7">
          <p class="eyebrow">{label} case study</p>
          <h1 class="mt-3 text-[clamp(2rem,1.5rem+2.2vw,3.25rem)]">{d.title}</h1>
          <p class="lead mt-5">{d.summary}</p>
        </div>
        <dl class="grid grid-cols-2 gap-4 self-end lg:col-span-5">
          {facts.map((f) => (
            <div class="rounded-xl border border-line bg-white p-4">
              <dt class="flex items-center gap-2 text-sm text-ink-muted"><Icon name={f.icon} size={16} class="text-teal" />{f.label}</dt>
              <dd class="mt-1 font-bold leading-snug">{f.value}</dd>
            </div>
          ))}
        </dl>
      </div>
      <div class="mt-10">
        <BeforeAfter before={d.before} after={d.after} label={d.title} sizes="(min-width: 1200px) 1136px, 100vw" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="prose lg:col-span-7 xl:col-span-8"><Content /></div>
      <aside class="lg:col-span-5 xl:col-span-4" aria-labelledby="materials-title">
        <div class="rounded-2xl border border-line bg-white p-6 sm:p-8 lg:sticky lg:top-[calc(var(--header-h)+1.5rem)]">
          <h2 id="materials-title" class="text-2xl">Materials used</h2>
          <dl class="mt-5 divide-y divide-line text-sm">
            {d.materials.map((m) => (
              <div class="py-3">
                <dt class="font-bold text-ink">{m.item}</dt>
                <dd class="mt-0.5 text-ink-soft">{m.detail}</dd>
              </div>
            ))}
          </dl>
          <h3 class="mt-6 border-t border-line pt-6 font-sans text-sm font-bold tracking-[0.12em] text-brass-text uppercase">Services on this project</h3>
          <ul class="mt-3 space-y-1">
            {services.map((s) => <li><a href={`/${s.id}`} class="link-arrow text-sm">{s.data.name} <Icon name="arrow" size={16} /></a></li>)}
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <section class="section bg-surface" aria-labelledby="photos-title">
    <div class="container-x">
      <SectionHeading eyebrow="Photos" title="Project gallery" id="photos-title" />
      <div class="mt-10"><Gallery items={gallery} id="project-gallery" /></div>
    </div>
  </section>

  <section class="section" aria-labelledby="more-title">
    <div class="container-x">
      <SectionHeading eyebrow="More projects" title="Other case studies" id="more-title" />
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {others.map((p, i) => <ProjectCard project={p} delay={i * 90} />)}
      </div>
    </div>
  </section>

  <CtaBand title="Planning something similar?" />
</BaseLayout>
