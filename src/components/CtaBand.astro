---
import CtaButtons from '@/components/CtaButtons.astro';
import { BUSINESS } from '@/config';
interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Ready to talk about your kitchen or bathroom?',
  text = `Book a free home visit. We’ll measure up, talk through ideas and budget, and follow up with a fixed written quote. No hard sell.`,
} = Astro.props;
---

<section class="section-tight" aria-labelledby="cta-band-title">
  <div class="container-x">
    <div class="on-dark relative overflow-hidden rounded-3xl bg-teal-dark px-6 py-12 text-white sm:px-12 sm:py-16" data-reveal>
      <svg class="pointer-events-none absolute -right-16 -bottom-24 h-80 w-80 text-white/5" viewBox="0 0 200 200" aria-hidden="true">
        <path d="M0 120c33-22 67-22 100 0s67 22 100 0M0 150c33-22 67-22 100 0s67 22 100 0M0 90c33-22 67-22 100 0s67 22 100 0" stroke="currentColor" stroke-width="10" fill="none" />
      </svg>
      <div class="relative max-w-2xl">
        <p class="eyebrow">Free home visit</p>
        <h2 id="cta-band-title" class="mt-3 text-white">{title}</h2>
        <p class="mt-4 text-lg text-[#d9e7e6]">{text}</p>
        <CtaButtons class="mt-8" />
        <p class="mt-6 text-sm text-[#d9e7e6]">
          Lines open {BUSINESS.hours.map((h) => `${h.short} ${h.opens.replace(/^0/, '')}–${h.closes}`).join(', ')}.
        </p>
      </div>
    </div>
  </div>
</section>
