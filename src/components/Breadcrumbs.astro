---
import JsonLd from '@/components/JsonLd.astro';
import { breadcrumbs, type Crumb } from '@/lib/schema';

interface Props {
  /** Trail after Home; the last item is the current page. */
  items: Crumb[];
  class?: string;
}
const { items, class: className } = Astro.props;
const trail: Crumb[] = [{ name: 'Home', href: '/' }, ...items];
---

<nav aria-label="Breadcrumb" class:list={['text-[0.8125rem]', className]}>
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-ink-muted">
    {
      trail.map((c, i) => (
        <li class="flex items-center gap-2">
          {i > 0 && (
            <span aria-hidden="true" class="text-brass">
              /
            </span>
          )}
          {i < trail.length - 1 ? (
            <a href={c.href} class="inline-flex min-h-8 items-center underline decoration-line underline-offset-4 hover:text-ink hover:decoration-ink">
              {c.name}
            </a>
          ) : (
            <span aria-current="page" class="font-semibold text-ink">
              {c.name}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
<JsonLd data={breadcrumbs(Astro.site, trail)} />
