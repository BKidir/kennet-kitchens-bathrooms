---
import Field from '@/components/forms/Field.astro';
import Icon from '@/components/ui/Icon.astro';
import { FORM_ENDPOINT, BUSINESS } from '@/config';
---

<div class="rounded-3xl border border-line bg-white p-5 shadow-[var(--shadow-card)] sm:p-8" data-contact>
  <form method="post" action={FORM_ENDPOINT || undefined} data-endpoint={FORM_ENDPOINT} class="space-y-6" data-contact-form>
    <input type="hidden" name="form" value="contact" />
    <div class="absolute -left-[9999px]" aria-hidden="true">
      <label>Leave this field empty <input type="text" name="company_website" tabindex="-1" autocomplete="off" /></label>
    </div>
    <div class="grid gap-6 sm:grid-cols-2">
      <Field idPrefix="c-" name="name" label="Full name" autocomplete="name" msgRequired="Please enter your name" class="sm:col-span-2" />
      <Field idPrefix="c-" name="email" label="Email address" type="email" autocomplete="email" pattern="^[^@\s]+@[^@\s]+\.[^@\s]{2,}$" msgRequired="Please enter your email address" msgPattern="Enter an email address in the format name@example.com" />
      <Field
        idPrefix="c-"
        name="phone"
        label="Phone number"
        type="tel"
        autocomplete="tel"
        optional
        pattern="^[0-9+()\s-]{10,20}$"
        msgPattern="Enter a phone number, like 01793 123456 or 07700 900123"
      />
    </div>
    <Field idPrefix="c-" name="message" label="How can we help?" as="textarea" rows={5} minlength={10} msgRequired="Please tell us a little about what you need" msgPattern="Please add a little more detail (at least 10 characters)" />
    <div class="field" data-group>
      <label class="flex items-start gap-3">
        <input type="checkbox" name="consent" value="yes" required class="mt-1 h-5 w-5 flex-none accent-teal" aria-describedby="consent-error" data-msg-required="Please confirm you’re happy for us to reply" />
        <span class="text-sm text-ink-soft">
          I’m happy for {BUSINESS.name} to use these details to reply to my enquiry. See our <a href="/privacy" class="link">privacy policy</a>.
        </span>
      </label>
      <p id="consent-error" class="field-error" aria-live="polite"></p>
    </div>
    <p class="field-error" role="alert" data-submit-error></p>
    <button type="submit" class="btn btn-primary w-full sm:w-auto" data-submit>Send message <Icon name="arrow" size={18} /></button>
  </form>

  <div data-success hidden>
    <span class="grid h-14 w-14 place-items-center rounded-full bg-teal-tint text-teal"><Icon name="check" size={28} strokeWidth={2.5} /></span>
    <h2 tabindex="-1" class="mt-6 text-2xl outline-none" data-success-title>Thanks, your message has been sent.</h2>
    <p class="mt-3 text-ink-soft">We reply to every message within one working day. If it’s urgent, call <a href={BUSINESS.phone.href} class="link">{BUSINESS.phone.display}</a>.</p>
  </div>
</div>

<script>
  import { validate, liveValidate, submit } from '@/scripts/forms';
  const root = document.querySelector<HTMLElement>('[data-contact]');
  if (root) {
    const form = root.querySelector<HTMLFormElement>('[data-contact-form]')!;
    const btn = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const err = form.querySelector<HTMLElement>('[data-submit-error]')!;
    form.noValidate = true;
    liveValidate(form);
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      err.textContent = '';
      const bad = validate(form);
      if (bad) return bad.focus();
      btn.disabled = true;
      btn.textContent = 'Sending…';
      try {
        await submit(form);
        form.hidden = true;
        const success = root.querySelector<HTMLElement>('[data-success]')!;
        success.hidden = false;
        success.querySelector<HTMLElement>('[data-success-title]')!.focus();
      } catch {
        err.textContent = 'Sorry, your message didn’t send. Please try again, or email us directly.';
        btn.disabled = false;
        btn.textContent = 'Send message';
      }
    });
  }
</script>
