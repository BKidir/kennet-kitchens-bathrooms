---
/**
 * Multi-step quote form. Without JS every step shows as one long form (still
 * submittable to a real endpoint). With JS it becomes a 6-step flow with a
 * progress indicator, per-step validation and focus management.
 */
import Field from '@/components/forms/Field.astro';
import ChoiceGroup from '@/components/forms/ChoiceGroup.astro';
import Icon from '@/components/ui/Icon.astro';
import { FORM_ENDPOINT, BUSINESS } from '@/config';

const steps = ['Project', 'Scope', 'Budget', 'Timing', 'Location', 'Your details'];
---

<div class="quote rounded-3xl border border-line bg-white p-5 shadow-[var(--shadow-card)] sm:p-8 lg:p-10" data-quote>
  <div class="progress mb-8" data-progress hidden>
    <p class="text-sm font-bold text-ink" aria-live="polite" data-progress-text>Step 1 of {steps.length}: {steps[0]}</p>
    <div class="mt-3 h-1.5 overflow-hidden rounded-full bg-surface" aria-hidden="true">
      <div class="progress-bar h-full origin-left rounded-full bg-teal" style={`transform: scaleX(${1 / steps.length})`}></div>
    </div>
    <ol class="mt-3 hidden grid-cols-6 gap-2 text-[0.75rem] text-ink-muted sm:grid" aria-label="Form steps">
      {steps.map((s, i) => <li data-step-label={i}>{s}</li>)}
    </ol>
  </div>

  <form method="post" action={FORM_ENDPOINT || undefined} data-endpoint={FORM_ENDPOINT} enctype="multipart/form-data" class="space-y-10" data-quote-form>
    <input type="hidden" name="form" value="quote" />
    <div class="absolute -left-[9999px]" aria-hidden="true">
      <label>Leave this field empty <input type="text" name="company_website" tabindex="-1" autocomplete="off" /></label>
    </div>

    <section data-step="0" aria-labelledby="q-step-0">
      <h2 id="q-step-0" tabindex="-1" class="step-title">What’s the project?</h2>
      <ChoiceGroup
        name="project_type"
        legend="Choose the room you’d like quoted"
        msgRequired="Please choose a project type"
        columns={2}
        options={[
          { value: 'Kitchen', label: 'New kitchen' },
          { value: 'Kitchen refurbishment', label: 'Kitchen refresh', note: 'New doors, worktops or both' },
          { value: 'Bathroom', label: 'Bathroom' },
          { value: 'Wet room', label: 'Wet room' },
          { value: 'En-suite', label: 'En-suite' },
          { value: 'Accessible bathroom', label: 'Accessible or walk-in bathroom' },
          { value: 'Cloakroom', label: 'Cloakroom or downstairs WC' },
          { value: 'Other', label: 'Something else', note: 'Tiling, or more than one room' },
        ]}
      />
    </section>

    <section data-step="1" aria-labelledby="q-step-1" class="space-y-8">
      <h2 id="q-step-1" tabindex="-1" class="step-title">Room size and scope</h2>
      <ChoiceGroup
        name="room_size"
        legend="Roughly how big is the room?"
        msgRequired="Please choose a room size"
        columns={3}
        options={[
          { value: 'Small', label: 'Small', note: 'Up to about 6 m²' },
          { value: 'Medium', label: 'Medium', note: 'About 6–12 m²' },
          { value: 'Large', label: 'Large', note: 'Over 12 m², or open plan' },
        ]}
      />
      <ChoiceGroup
        name="scope"
        legend="How much are you changing?"
        msgRequired="Please choose the scope of work"
        columns={1}
        options={[
          { value: 'New layout', label: 'A full redesign with a new layout', note: 'Moving plumbing, walls or appliances' },
          { value: 'Like-for-like', label: 'A full replacement in the same layout' },
          { value: 'Refresh', label: 'A refresh', note: 'Keeping some of what’s there' },
        ]}
      />
      <Field name="details" label="Anything else we should know?" as="textarea" optional rows={4} hint="For example: the age of the house, a wall you’d like removed, or a style you like" />
    </section>

    <section data-step="2" aria-labelledby="q-step-2">
      <h2 id="q-step-2" tabindex="-1" class="step-title">Budget</h2>
      <ChoiceGroup
        name="budget"
        legend="What budget range are you working to?"
        hint="Including fitting. Most of our kitchens are £12k–£35k and bathrooms £8k–£20k."
        msgRequired="Please choose a budget range"
        columns={2}
        options={[
          { value: 'Under £8,000', label: 'Under £8,000' },
          { value: '£8,000–£12,000', label: '£8,000 – £12,000' },
          { value: '£12,000–£20,000', label: '£12,000 – £20,000' },
          { value: '£20,000–£35,000', label: '£20,000 – £35,000' },
          { value: 'Over £35,000', label: 'Over £35,000' },
          { value: 'Not sure yet', label: 'Not sure yet', note: 'We’ll help you work it out' },
        ]}
      />
    </section>

    <section data-step="3" aria-labelledby="q-step-3">
      <h2 id="q-step-3" tabindex="-1" class="step-title">Timing</h2>
      <ChoiceGroup
        name="start"
        legend="When would you ideally like work to start?"
        hint="Installation slots are usually booked 6–10 weeks ahead."
        msgRequired="Please choose a start date"
        columns={2}
        options={[
          { value: 'As soon as possible', label: 'As soon as possible' },
          { value: '1–3 months', label: 'In 1–3 months' },
          { value: '3–6 months', label: 'In 3–6 months' },
          { value: '6+ months', label: 'In 6 months or more' },
          { value: 'Just researching', label: 'Just researching for now' },
        ]}
      />
    </section>

    <section data-step="4" aria-labelledby="q-step-4">
      <h2 id="q-step-4" tabindex="-1" class="step-title">Where’s the property?</h2>
      <Field
        name="postcode"
        label="Postcode"
        hint="We cover Swindon and about 20 miles around it, including Chippenham, Marlborough and Cirencester"
        autocomplete="postal-code"
        inputmode="text"
        autocapitalize="characters"
        pattern="^\s*[A-Za-z]{1,2}[0-9][A-Za-z0-9]?\s*[0-9][A-Za-z]{2}\s*$"
        msgRequired="Please enter your postcode"
        msgPattern="Enter a full UK postcode, like SN1 0AA"
        class="max-w-xs"
      />
    </section>

    <section data-step="5" aria-labelledby="q-step-5" class="space-y-6">
      <h2 id="q-step-5" tabindex="-1" class="step-title">Your details</h2>
      <div class="grid gap-6 sm:grid-cols-2">
        <Field name="name" label="Full name" autocomplete="name" msgRequired="Please enter your name" class="sm:col-span-2" />
        <Field name="email" label="Email address" type="email" autocomplete="email" pattern="^[^@\s]+@[^@\s]+\.[^@\s]{2,}$" msgRequired="Please enter your email address" msgPattern="Enter an email address in the format name@example.com" />
        <Field
          name="phone"
          label="Phone number"
          type="tel"
          autocomplete="tel"
          pattern="^[0-9+()\s-]{10,20}$"
          msgRequired="Please enter a phone number"
          msgPattern="Enter a phone number, like 01793 123456 or 07700 900123"
        />
        <Field
          name="contact_time"
          label="Best time to contact you"
          as="select"
          options={['Morning (8am–12pm)', 'Afternoon (12pm–5pm)', 'Early evening (5pm–7pm)', 'Any time']}
          msgRequired="Please choose a contact time"
        />
      </div>

      <div class="field">
        <label for="photos" class="field-label">Photos of the room <span class="font-normal text-ink-muted">(optional)</span></label>
        <span id="photos-hint" class="field-hint">A few quick phone photos help us prepare for the visit. JPG or PNG.</span>
        <label for="photos" class="upload flex min-h-24 cursor-pointer flex-col items-center justify-center gap-2 rounded-xl border-2 border-dashed border-line bg-bg p-6 text-center text-sm">
          <Icon name="upload" size={24} class="text-teal" />
          <span><span class="font-bold text-teal underline underline-offset-2">Choose photos</span> or drag them here</span>
        </label>
        <input id="photos" name="photos" type="file" accept="image/*" multiple class="sr-only" aria-describedby="photos-hint photos-list" />
        <ul id="photos-list" class="mt-3 space-y-1 text-sm text-ink-soft" aria-live="polite"></ul>
      </div>

      <div class="field" data-group>
        <label class="flex items-start gap-3">
          <input
            type="checkbox"
            name="consent"
            value="yes"
            required
            class="mt-1 h-5 w-5 flex-none accent-teal"
            aria-describedby="consent-error"
            data-msg-required="Please confirm you’re happy for us to contact you"
          />
          <span class="text-sm text-ink-soft">
            I’m happy for {BUSINESS.name} to use these details to contact me about my quote. We never share or sell your data. See our <a href="/privacy" class="link">privacy policy</a>.
          </span>
        </label>
        <p id="consent-error" class="field-error" aria-live="polite"></p>
      </div>
    </section>

    <p class="field-error" role="alert" data-submit-error></p>

    <div class="flex flex-col-reverse gap-3 border-t border-line pt-6 sm:flex-row sm:items-center sm:justify-between" data-nav>
      <button type="button" class="btn btn-secondary" data-prev hidden>
        <Icon name="chevronLeft" size={18} /> Back
      </button>
      <span class="hidden sm:block" data-spacer></span>
      <button type="button" class="btn btn-primary" data-next hidden>
        Continue <Icon name="arrow" size={18} />
      </button>
      <button type="submit" class="btn btn-primary" data-submit>
        Send my quote request <Icon name="arrow" size={18} />
      </button>
    </div>
  </form>

  <div class="success" data-success hidden>
    <span class="grid h-14 w-14 place-items-center rounded-full bg-teal-tint text-teal"><Icon name="check" size={28} strokeWidth={2.5} /></span>
    <h2 tabindex="-1" class="mt-6 text-3xl outline-none" data-success-title>Thank you. Your request is in.</h2>
    <p class="lead mt-3">We’ve got everything we need to get started. Here’s what happens next:</p>
    <ol class="mt-8 space-y-6">
      <li class="flex gap-4">
        <span class="step-dot">1</span>
        <div><p class="font-bold">We’ll be in touch within one working day</p><p class="text-sm text-ink-soft">At the time you asked for, to talk through the project and answer any questions.</p></div>
      </li>
      <li class="flex gap-4">
        <span class="step-dot">2</span>
        <div><p class="font-bold">We book your free home visit</p><p class="text-sm text-ink-soft">A designer measures up and brings samples. It takes about an hour.</p></div>
      </li>
      <li class="flex gap-4">
        <span class="step-dot">3</span>
        <div><p class="font-bold">You get your design and fixed quote</p><p class="text-sm text-ink-soft">Usually within ten working days, with 3D visuals and an itemised price.</p></div>
      </li>
    </ol>
    <p class="mt-8 text-sm text-ink-soft">
      Can’t wait? Call us on <a href={BUSINESS.phone.href} class="link">{BUSINESS.phone.display}</a>. Meanwhile, browse <a href="/projects" class="link">recent projects</a>.
    </p>
  </div>
</div>

<style>
  .step-title {
    font-size: var(--text-2xl);
    margin-bottom: 1.25rem;
    outline: none;
  }
  .js .quote.is-stepped .step-title {
    margin-bottom: 1.5rem;
  }
  .progress-bar {
    transition: transform 400ms var(--ease-out-soft);
  }
  [data-step-label].is-current {
    color: var(--color-ink);
    font-weight: 700;
  }
  [data-step-label].is-done {
    color: var(--color-teal);
  }
  .upload:hover {
    border-color: var(--color-teal);
  }
  #photos:focus-visible + ul,
  .field:has(#photos:focus-visible) .upload {
    outline: 3px solid var(--color-teal);
    outline-offset: 2px;
  }
  .step-dot {
    display: grid;
    place-items: center;
    flex: none;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: var(--color-ink);
    color: #fff;
    font-weight: 700;
    font-size: var(--text-sm);
  }
  @media (prefers-reduced-motion: no-preference) {
    .is-stepped [data-step]:not([hidden]) {
      animation: step-in 350ms var(--ease-out-soft);
    }
  }
  @keyframes step-in {
    from {
      opacity: 0;
      transform: translateX(16px);
    }
  }
</style>

<script>
  import { validate, liveValidate, submit } from '@/scripts/forms';

  const root = document.querySelector<HTMLElement>('[data-quote]');
  if (root) {
    const form = root.querySelector<HTMLFormElement>('[data-quote-form]')!;
    const steps = [...form.querySelectorAll<HTMLElement>('[data-step]')];
    const labels = [...root.querySelectorAll<HTMLElement>('[data-step-label]')];
    const progress = root.querySelector<HTMLElement>('[data-progress]')!;
    const progressText = root.querySelector<HTMLElement>('[data-progress-text]')!;
    const bar = root.querySelector<HTMLElement>('.progress-bar')!;
    const prev = form.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = form.querySelector<HTMLButtonElement>('[data-next]')!;
    const send = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const submitError = form.querySelector<HTMLElement>('[data-submit-error]')!;
    const names = labels.map((l) => l.textContent?.trim() ?? '');
    let current = 0;

    form.noValidate = true;
    root.classList.add('is-stepped');
    progress.hidden = false;
    liveValidate(form);

    const go = (i: number, focus = true) => {
      current = i;
      steps.forEach((s, n) => (s.hidden = n !== i));
      labels.forEach((l, n) => {
        l.classList.toggle('is-current', n === i);
        l.classList.toggle('is-done', n < i);
        if (n === i) l.setAttribute('aria-current', 'step');
        else l.removeAttribute('aria-current');
      });
      progressText.textContent = `Step ${i + 1} of ${steps.length}: ${names[i]}`;
      bar.style.transform = `scaleX(${(i + 1) / steps.length})`;
      prev.hidden = i === 0;
      next.hidden = i === steps.length - 1;
      send.hidden = i !== steps.length - 1;
      if (focus) {
        const title = steps[i].querySelector<HTMLElement>('.step-title')!;
        title.focus({ preventScroll: true });
        root.scrollIntoView({ block: 'start', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      }
    };

    // Prefill project type from ?type=... (e.g. links from service pages)
    const type = new URLSearchParams(location.search).get('type');
    if (type) {
      const radio = form.querySelector<HTMLInputElement>(`input[name="project_type"][value="${CSS.escape(type)}"]`);
      if (radio) radio.checked = true;
    }

    next.addEventListener('click', () => {
      const bad = validate(steps[current]);
      if (bad) return bad.focus();
      go(current + 1);
    });
    prev.addEventListener('click', () => go(current - 1));

    // Enter in a text field moves forward instead of submitting early
    form.addEventListener('keydown', (e) => {
      const t = e.target as HTMLElement;
      if (e.key === 'Enter' && t instanceof HTMLInputElement && current < steps.length - 1) {
        e.preventDefault();
        next.click();
      }
    });

    // Photo list (UI only in the demo)
    const photos = form.querySelector<HTMLInputElement>('#photos')!;
    const list = form.querySelector<HTMLUListElement>('#photos-list')!;
    const upload = form.querySelector<HTMLElement>('.upload')!;
    const showFiles = () => {
      list.replaceChildren(
        ...[...(photos.files ?? [])].map((f) => {
          const li = document.createElement('li');
          li.textContent = `✓ ${f.name} (${Math.max(1, Math.round(f.size / 1024))} KB)`;
          return li;
        }),
      );
    };
    photos.addEventListener('change', showFiles);
    upload.addEventListener('dragover', (e) => e.preventDefault());
    upload.addEventListener('drop', (e) => {
      e.preventDefault();
      if (e.dataTransfer?.files.length) {
        photos.files = e.dataTransfer.files;
        showFiles();
      }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      submitError.textContent = '';
      // Validate every step; jump to the first one with a problem
      for (let i = 0; i < steps.length; i++) {
        steps[i].hidden = false;
        const bad = validate(steps[i]);
        steps[i].hidden = i !== current;
        if (bad) {
          go(i, false);
          bad.focus();
          return;
        }
      }
      send.disabled = true;
      send.textContent = 'Sending…';
      try {
        await submit(form);
        const name = String(new FormData(form).get('name') ?? '').trim().split(/\s+/)[0];
        const title = root.querySelector<HTMLElement>('[data-success-title]')!;
        if (name) title.textContent = `Thank you, ${name}. Your request is in.`;
        form.hidden = true;
        progress.hidden = true;
        root.querySelector<HTMLElement>('[data-success]')!.hidden = false;
        title.focus();
      } catch {
        submitError.textContent = 'Sorry, something went wrong sending your request. Please try again, or call us.';
        send.disabled = false;
        send.textContent = 'Send my quote request';
      }
    });

    go(0, false);
  }
</script>
