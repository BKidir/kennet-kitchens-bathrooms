---
/** Radio group rendered as tappable tiles inside a fieldset with a legend. */
interface Props {
  name: string;
  legend: string;
  hint?: string;
  options: { value: string; label: string; note?: string }[];
  msgRequired: string;
  columns?: 1 | 2 | 3;
  legendClass?: string;
}
const { name, legend, hint, options, msgRequired, columns = 2, legendClass = 'field-label' } = Astro.props;
const cols = { 1: '', 2: 'sm:grid-cols-2', 3: 'sm:grid-cols-2 lg:grid-cols-3' }[columns];
---

<fieldset data-group aria-describedby={[hint && `${name}-hint`, `${name}-error`].filter(Boolean).join(' ')}>
  <legend class={legendClass}>{legend}</legend>
  {hint && <p id={`${name}-hint`} class="field-hint">{hint}</p>}
  <p id={`${name}-error`} class="field-error mb-3" aria-live="polite"></p>
  <div class:list={['grid gap-3', cols]}>
    {
      options.map((o, i) => (
        <label class="choice">
          <input type="radio" name={name} value={o.value} required={i === 0} data-msg-required={msgRequired} />
          <span>
            {o.label}
            {o.note && <span class="block text-[0.8125rem] font-normal text-ink-muted">{o.note}</span>}
          </span>
        </label>
      ))
    }
  </div>
</fieldset>
