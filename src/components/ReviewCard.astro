---
import Icon from '@/components/ui/Icon.astro';
import type { Review } from '@/data/content';
interface Props {
  review: Review;
  delay?: number;
}
const { review, delay = 0 } = Astro.props;
---

<figure class="flex h-full flex-col rounded-[var(--radius-card)] border border-line bg-white p-6 sm:p-8" data-reveal style={`--reveal-delay:${delay}ms`}>
  <Icon name="quote" size={28} class="text-brass" />
  <blockquote class="mt-4 flex-1 font-serif text-lg leading-relaxed text-ink">
    <p>“{review.quote}”</p>
  </blockquote>
  <figcaption class="mt-6 border-t border-line pt-4 text-sm">
    <span class="font-bold text-ink">{review.name}</span>
    <span class="text-ink-muted"> · {review.place}</span>
    <span class="mt-0.5 block text-ink-muted">{review.project}</span>
  </figcaption>
</figure>
