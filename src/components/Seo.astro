---
import { IS_DEMO, BUSINESS } from '@/config';
import { cleanPath } from '@/lib/path';

export type OgType = 'default' | 'kitchens' | 'bathrooms' | 'projects' | 'advice' | 'areas';

interface Props {
  title: string;
  description: string;
  og?: OgType;
  ogImageUrl?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  published?: Date;
}

const { title, description, og = 'default', ogImageUrl, type = 'website', noindex = false, published } = Astro.props;
const canonical = new URL(cleanPath(Astro.url), Astro.site).href;
const image = ogImageUrl ?? new URL(`/og/${og}.png`, Astro.site).href;
const robots = IS_DEMO || noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={robots} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={BUSINESS.name} />
<meta property="og:locale" content="en_GB" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${BUSINESS.name}: ${BUSINESS.tagline}`} />
{published && <meta property="article:published_time" content={published.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
