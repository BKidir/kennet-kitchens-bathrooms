---
import Logo from '@/components/ui/Logo.astro';
import Icon from '@/components/ui/Icon.astro';
import { BUSINESS, MAIN_NAV, QUOTE_HREF } from '@/config';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href;
const isSection = (item: (typeof MAIN_NAV)[number]) =>
  path === item.href || path.startsWith(item.href + '/') || (item.children?.some((c) => c.href === path) ?? false);
---

<header class="site-header no-print" data-header>
  <div class="header-inner container-x flex h-full items-center justify-between gap-4">
    <a href="/" class="logo-link -ml-1 flex min-h-11 items-center rounded-md px-1">
      <Logo class="h-11 w-auto sm:h-12 lg:h-11 xl:h-12" /><span class="sr-only">, home</span>
    </a>

    <nav class="hidden lg:block" aria-label="Main">
      <ul class="flex items-center xl:gap-2">
        {
          MAIN_NAV.map((item) =>
            item.children ? (
              <li class="has-menu relative flex items-center" data-menu>
                <a
                  href={item.href}
                  class:list={['nav-link', { 'is-active': isSection(item) }]}
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
                <button
                  type="button"
                  class="menu-toggle -ml-2 grid h-11 w-8 place-items-center rounded-md text-ink-soft"
                  aria-expanded="false"
                  aria-controls={`menu-${item.label.toLowerCase()}`}
                >
                  <span class="sr-only">Show {item.label.toLowerCase()} services</span>
                  <Icon name="chevron" size={16} class="chev" />
                </button>
                <div id={`menu-${item.label.toLowerCase()}`} class="dropdown">
                  <ul class="grid w-[34rem] grid-cols-2 gap-1 rounded-2xl border border-line bg-white p-3 shadow-[var(--shadow-lift)]">
                    {item.children.map((c) => (
                      <li>
                        <a
                          href={c.href}
                          class="block rounded-lg px-3 py-2.5 no-underline hover:bg-surface"
                          aria-current={isCurrent(c.href) ? 'page' : undefined}
                        >
                          <span class="block text-sm font-bold text-ink">{c.label}</span>
                          <span class="block text-[0.8125rem] leading-snug text-ink-muted">{c.description}</span>
                        </a>
                      </li>
                    ))}
                    <li class="col-span-2 mt-1 border-t border-line pt-2">
                      <a href={item.href} class="link-arrow px-3 text-sm">
                        All {item.label.toLowerCase()} <Icon name="arrow" size={16} />
                      </a>
                    </li>
                  </ul>
                </div>
              </li>
            ) : (
              <li>
                <a
                  href={item.href}
                  class:list={['nav-link', { 'is-active': isSection(item) }]}
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      <a href={BUSINESS.phone.href} class="hidden min-h-11 items-center gap-2 rounded-md px-2 font-bold whitespace-nowrap text-ink no-underline md:inline-flex lg:hidden min-[1440px]:inline-flex">
        <Icon name="phone" size={18} class="text-teal" />
        <span><span class="sr-only">Call us on </span>{BUSINESS.phone.display}</span>
      </a>
      <a href={QUOTE_HREF} class="btn btn-primary hidden sm:inline-flex lg:px-4 xl:px-6"><span class="lg:hidden xl:inline">Get a free quote</span><span class="hidden lg:inline xl:hidden">Get a quote</span></a>
      <button
        type="button"
        class="menu-button grid h-12 w-12 place-items-center rounded-full border border-line bg-white lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-mobile-toggle
      >
        <span class="sr-only" data-mobile-label>Open menu</span>
        <Icon name="menu" size={22} class="icon-open" />
        <Icon name="close" size={22} class="icon-close hidden" />
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu lg:hidden" hidden>
    <nav aria-label="Mobile" class="container-x pb-10 pt-4">
      <ul class="divide-y divide-line border-y border-line">
        {
          MAIN_NAV.map((item) =>
            item.children ? (
              <li>
                <details class="group/d" open={isSection(item)}>
                  <summary class="flex min-h-14 items-center justify-between font-serif text-xl">
                    {item.label}
                    <Icon name="chevron" size={20} class="transition-transform group-open/d:rotate-180" />
                  </summary>
                  <ul class="pb-3 pl-1">
                    <li>
                      <a href={item.href} class="flex min-h-11 items-center font-bold text-teal no-underline">
                        All {item.label.toLowerCase()}
                      </a>
                    </li>
                    {item.children.map((c) => (
                      <li>
                        <a
                          href={c.href}
                          class="flex min-h-11 items-center text-ink-soft no-underline"
                          aria-current={isCurrent(c.href) ? 'page' : undefined}
                        >
                          {c.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              </li>
            ) : (
              <li>
                <a
                  href={item.href}
                  class="flex min-h-14 items-center font-serif text-xl no-underline"
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ),
          )
        }
        <li><a href="/reviews" class="flex min-h-14 items-center font-serif text-xl no-underline">Reviews</a></li>
        <li><a href="/faqs" class="flex min-h-14 items-center font-serif text-xl no-underline">FAQs</a></li>
      </ul>
      <div class="mt-8 grid gap-3">
        <a href={QUOTE_HREF} class="btn btn-primary w-full">Get a free quote</a>
        <a href={BUSINESS.phone.href} class="btn btn-secondary w-full">
          <Icon name="phone" size={18} /> Call {BUSINESS.phone.display}
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    transition: transform 300ms var(--ease-out-soft);
  }
  .site-header::before,
  .site-header::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .site-header::before {
    background: rgb(250 248 245 / 0.94);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--color-line);
  }
  /* Shadow fades in once scrolled (opacity only) */
  .site-header::after {
    box-shadow: 0 10px 30px -18px rgb(31 41 51 / 0.45);
    opacity: 0;
    transition: opacity 300ms;
  }
  .header-inner {
    transition: transform 300ms var(--ease-out-soft);
  }
  .logo-link :global(img) {
    transform-origin: left center;
    transition: transform 300ms var(--ease-out-soft);
  }
  /* Shrink on scroll: transforms only, so no layout work */
  .site-header.is-scrolled {
    transform: translateY(-12px);
  }
  .site-header.is-scrolled .header-inner {
    transform: translateY(6px);
  }
  .site-header.is-scrolled .logo-link :global(img) {
    transform: scale(0.88);
  }
  .site-header.is-scrolled::after {
    opacity: 1;
  }
  .site-header.menu-open {
    transform: none;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 0.75rem;
    border-radius: 0.375rem;
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--color-ink);
    text-decoration: none;
    white-space: nowrap;
  }
  @media (min-width: 1024px) and (max-width: 1279px) {
    .nav-link {
      padding: 0 0.5rem;
    }
  }
  @media (min-width: 1280px) and (max-width: 1535px) {
    .nav-link {
      padding: 0 0.5625rem;
    }
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.4rem;
    height: 2px;
    background: var(--color-brass);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 250ms var(--ease-out-soft);
  }
  .nav-link:hover::after,
  .nav-link.is-active::after {
    transform: scaleX(1);
  }

  .dropdown {
    position: absolute;
    top: 100%;
    left: -0.5rem;
    padding-top: 0.5rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition:
      opacity 200ms,
      transform 200ms var(--ease-out-soft),
      visibility 0s linear 200ms;
  }
  @media (hover: hover) {
    .has-menu:hover .dropdown {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition-delay: 0s;
    }
  }
  .has-menu[data-open] .dropdown {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }
  .chev {
    transition: transform 200ms;
  }
  .has-menu[data-open] .chev {
    transform: rotate(180deg);
  }

  .mobile-menu {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    background: var(--color-bg);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .mobile-menu:not([hidden]) {
    animation: menu-in 220ms var(--ease-out-soft);
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary {
    list-style: none;
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;

  // Shrink on scroll (rAF-throttled, passive listener)
  let ticking = false;
  const update = () => {
    header.classList.toggle('is-scrolled', window.scrollY > 24);
    ticking = false;
  };
  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    },
    { passive: true },
  );
  requestAnimationFrame(update);

  // Desktop dropdowns: disclosure buttons
  const menus = [...document.querySelectorAll<HTMLElement>('[data-menu]')];
  const closeAll = (except?: HTMLElement) =>
    menus.forEach((m) => {
      if (m === except) return;
      m.removeAttribute('data-open');
      m.querySelector('button')?.setAttribute('aria-expanded', 'false');
    });
  menus.forEach((menu) => {
    const btn = menu.querySelector('button')!;
    btn.addEventListener('click', () => {
      const open = !menu.hasAttribute('data-open');
      closeAll(menu);
      menu.toggleAttribute('data-open', open);
      btn.setAttribute('aria-expanded', String(open));
    });
    menu.addEventListener('focusout', (e) => {
      if (!menu.contains(e.relatedTarget as Node)) closeAll();
    });
  });
  document.addEventListener('click', (e) => {
    if (!menus.some((m) => m.contains(e.target as Node))) closeAll();
  });

  // Mobile menu
  const toggle = document.querySelector<HTMLButtonElement>('[data-mobile-toggle]')!;
  const panel = document.getElementById('mobile-menu')!;
  const label = toggle.querySelector('[data-mobile-label]')!;
  const setMobile = (open: boolean) => {
    panel.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    label.textContent = open ? 'Close menu' : 'Open menu';
    toggle.querySelector('.icon-open')!.classList.toggle('hidden', open);
    toggle.querySelector('.icon-close')!.classList.toggle('hidden', !open);
    header.classList.toggle('menu-open', open);
    document.documentElement.style.overflow = open ? 'hidden' : '';
    // Keep the rest of the page out of the tab order while the menu covers it
    document.querySelectorAll('main, footer, [data-mobile-bar]').forEach((el) => el.toggleAttribute('inert', open));
  };
  toggle.addEventListener('click', () => setMobile(panel.hasAttribute('hidden')));
  matchMedia('(min-width: 1024px)').addEventListener('change', (e) => e.matches && setMobile(false));

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (!panel.hasAttribute('hidden')) {
      setMobile(false);
      toggle.focus();
      return;
    }
    const open = menus.find((m) => m.hasAttribute('data-open'));
    if (open) {
      closeAll();
      open.querySelector('button')?.focus();
    }
  });
</script>
